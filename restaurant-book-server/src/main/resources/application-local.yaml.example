aws:
  s3:
    access-key: YOUR_AWS_ACCESS_KEY_ID
    secret-key: YOUR_AWS_SECRET_ACCESS_KEY
    bucket: your-bucket-name
    region: ap-northeast-2
    prefix: restaurant-book

# 로컬에서 실제 Gmail SMTP 없이 인증 플로우만 테스트하려면 true로 둡니다.
# 서버 로그에 6자리 인증코드가 출력됩니다.
auth:
  email-verification:
    log-only: true
    dev-bypass-code: "1234"

# 실제 Gmail 발송을 테스트하려면 위 log-only를 false로 바꾸고
# MAIL_USERNAME / MAIL_PASSWORD 환경변수 또는 아래 값을 설정하세요.
# spring:
#   mail:
#     username: your-gmail@gmail.com
#     password: your-google-app-password
